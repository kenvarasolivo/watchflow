# ---------------------------------------------------------------------------
# Watchflow environment
#
# Local dev:  copy this file to `.env.local` and fill in DATABASE_URL.
# Vercel:     set DATABASE_URL (and optionally WATCHFLOW_WRITE_TOKEN) in
#             Project Settings → Environment Variables.
# GitHub:     set DATABASE_URL as a repository *secret* so the scheduled
#             pipeline workflow can reach Neon.
# ---------------------------------------------------------------------------

# Neon serverless Postgres connection string.
# Neon Console → your project → Connection Details → "Connection string".
# Keep `?sslmode=require`; Neon rejects unencrypted connections.
#
# Note the two driver flavours share this one URL:
#   - Next.js uses it over Neon's HTTP driver (@neondatabase/serverless)
#   - the Python pipeline uses it over plain TCP via psycopg
# The pipeline rewrites a `postgres://` scheme to `postgresql+psycopg://`
# itself, so you can paste Neon's string verbatim.
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/watchflow?sslmode=require"

# Optional shared secret gating the mutating API routes
# (POST /api/watchlist, DELETE /api/watchlist/:ticker).
#
# Leave unset for local development and writes are open. Set it on any public
# deployment, otherwise anyone who finds the URL can edit the watchlist.
# Generate one with:  openssl rand -hex 24
WATCHFLOW_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Pipeline-only settings (read by pipeline/, not by Next.js).
# All are optional — the defaults shown are what the scheduled run uses.
# ---------------------------------------------------------------------------

# curl_cffi browser profile used to impersonate a real TLS fingerprint.
# See the README section "The TLS fingerprint problem" for why this exists.
# Valid values track curl_cffi's supported targets, e.g. chrome, chrome124,
# chrome131, safari17_0, edge101.
WATCHFLOW_IMPERSONATE="chrome"

# How far back to reach when a ticker has no rows at all (first ever run).
WATCHFLOW_BACKFILL_DAYS="400"

# Re-fetch this many calendar days before each ticker's last stored date.
# Yahoo revises recent bars (split/dividend adjustments, late prints), so the
# tail is deliberately refetched and upserted rather than trusted.
WATCHFLOW_OVERLAP_DAYS="5"

# Retry policy for Yahoo requests (exponential backoff with jitter).
WATCHFLOW_MAX_RETRIES="5"
WATCHFLOW_BACKOFF_BASE_SECONDS="1.5"

# How many tickers to request per yfinance batch call.
WATCHFLOW_BATCH_SIZE="12"

# Marks the run in the pipeline_runs log. The workflow sets this to
# "schedule" or "workflow_dispatch"; local runs default to "manual".
WATCHFLOW_TRIGGER="manual"
